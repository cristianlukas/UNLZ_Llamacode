<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LlamaCode</vendor>
  <vendor_url>https://github.com/cristianlukas/UNLZ_Llamacode</vendor_url>
  <action id="org.llamacode.3090-helper.repair">
    <description>Relanzar arreglos de 3090 HELPER</description>
    <message>Relanzar la reserva VRAM ASUS y volver a verificar las protecciones NVIDIA</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LC_3090_HELPER_ADMIN_PATH@</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">repair</annotate>
  </action>
</policyconfig>
