{# Bailing V3 / Ling 3.0 Tiny: thinking + native tool calls #}
{%- if enable_thinking is defined %}
  {%- if enable_thinking %}{%- set thinking_option = 'on' %}
  {%- else %}{%- set thinking_option = 'off' %}{%- endif %}
{%- elif thinking_option is not defined %}
  {%- set thinking_option = 'on' %}
{%- endif %}
{%- set preserved_thinking = true %}
{{- '<role>SYSTEM</role>' }}
{%- if tools %}
{{- '# Tools\n\nYou may call one or more functions to assist with the user query.\n\n<tools>' }}
{%- for tool in tools %}{{- '\n' }}{{- tool | tojson }}{%- endfor %}
{{- '\n</tools>\n\nIf you need to use a function, output it as:\n<tool_call>{function-name}\n<arg_key>{arg-key}</arg_key>\n<arg_value>{arg-value}</arg_value>\n</tool_call>\n' }}
{%- endif %}
{{- 'detailed thinking ' + thinking_option + '<|role_end|>' }}
{%- for message in messages %}
  {%- if message.role == 'user' %}
    {{- '<role>HUMAN</role>' + message.content + '<|role_end|>' }}
  {%- elif message.role == 'system' %}
    {{- '<role>SYSTEM</role>' + message.content + '<|role_end|>' }}
  {%- elif message.role == 'assistant' %}
    {%- set content = message.content if message.content is string else '' %}
    {%- set reasoning = message.reasoning_content if message.reasoning_content is string else '' %}
    {{- '<role>ASSISTANT</role>' }}
    {%- if preserved_thinking %}
      {%- if reasoning %}{{- '\n<think>' + reasoning + '</think>' }}
      {%- elif '</think>' in content %}{{- content.split('</think>')[0] + '</think>' }}{%- set content = content.split('</think>')[-1] %}
      {%- else %}{{- '\n<think></think>' }}{%- endif %}
    {%- endif %}
    {{- content }}
    {%- if message.tool_calls %}
      {%- for tool_call in message.tool_calls %}
        {%- set tc = tool_call.function if tool_call.function else tool_call %}
        {{- '\n<tool_call>' + tc.name }}
        {%- for k, v in tc.arguments.items() %}
          {{- '<arg_key>' + k + '</arg_key>\n<arg_value>' }}
          {%- if v is string %}{{- v }}{%- else %}{{- v | tojson(ensure_ascii=False) }}{%- endif %}
          {{- '</arg_value>' }}
        {%- endfor %}
        {{- '\n</tool_call>' }}
      {%- endfor %}
    {%- endif %}
    {{- '<|role_end|>' }}
  {%- elif message.role == 'tool' %}
    {{- '<role>OBSERVATION</role>\n<tool_response>\n' + message.content + '\n</tool_response><|role_end|>' }}
  {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
  {{- '<role>ASSISTANT</role>' }}
  {%- if thinking_option == 'on' %}{{- '\n<think>' }}{%- else %}{{- '\n<think></think>' }}{%- endif %}
{%- endif %}
